#!/usr/bin/python3
"""luxafor-tray — system tray icon showing the current Luxafor status,
with a menu to change it. Statuses come from the same configuration
file as luxafor-toggle and are reloaded automatically when it changes."""
import glob
import hashlib
import os
import re
import shutil
import subprocess
import sys
import time
import traceback

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AI  # noqa: E402
from gi.repository import Gio, GLib, Gtk  # noqa: E402

# --- translations ------------------------------------------------------------------

def _translation():
    """Messages in the user's language (gettext domain luxafor-status)."""
    import gettext

    home = os.path.expanduser("~")
    dirs = [
        os.environ.get("LUXAFOR_LOCALEDIR"),
        f"{os.environ.get('XDG_DATA_HOME', home + '/.local/share')}/locale",
        "/usr/local/share/locale",
        "/usr/share/locale",
    ]
    for d in dirs:
        if d and gettext.find("luxafor-status", d):
            return gettext.translation("luxafor-status", d)
    return gettext.NullTranslations()


_ = _translation().gettext

HOME = os.path.expanduser("~")
DATA_HOME = os.environ.get("XDG_DATA_HOME", f"{HOME}/.local/share")
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config")
CACHE_HOME = os.environ.get("XDG_CACHE_HOME", f"{HOME}/.cache")

# Prefer the luxafor-toggle installed next to this script (per-user or package).
_HERE = os.path.dirname(os.path.realpath(__file__))
PANEL = f"{_HERE}/luxafor-panel" if os.path.isfile(f"{_HERE}/luxafor-panel") else "luxafor-panel"
TOGGLE = (
    f"{_HERE}/luxafor-toggle"
    if os.path.isfile(f"{_HERE}/luxafor-toggle")
    else shutil.which("luxafor-toggle") or f"{HOME}/.local/bin/luxafor-toggle"
)
CONF = f"{CONFIG_HOME}/luxafor-status/statuses.conf"
# Default statuses: per-user install (~/.local/share) or package (/usr/share).
DATA_DIRS = [DATA_HOME] + os.environ.get(
    "XDG_DATA_DIRS", "/usr/local/share:/usr/share"
).split(":")
DEFAULT_CONF = next(
    (
        f"{d}/luxafor-status/statuses.conf"
        for d in DATA_DIRS
        if d and os.path.isfile(f"{d}/luxafor-status/statuses.conf")
    ),
    f"{DATA_HOME}/luxafor-status/statuses.conf",
)
STATE = f"{CACHE_HOME}/luxafor-state"
TIMER = f"{CACHE_HOME}/luxafor-timer"


# Tray icons go straight into ~/.local/share/icons: every icon lookup
# (GTK and system tray hosts such as Budgie's) searches that folder.
# File names include a hash of the color, so a color change gives a new
# name and tray hosts can't keep showing a cached, outdated icon.
#
# The prefix must not start with the name of any other icon: when a name
# is not found, GTK retries with shorter names cut at each "-" (generic
# fallback), and some tray hosts (e.g. Budgie) accept that match instead
# of looking in the indicator's icon path. "luxafor-tray-busy" would end
# up as "luxafor", hence the unrelated "lxftray-" prefix.
TRAY_ICON_DIR = f"{DATA_HOME}/icons"
TRAY_ICON_PREFIX = "lxftray-"
# Light unplugged: dashed ring. A prefix of its own, for the same reason.
AWAY_ICON_PREFIX = "lxftrayx-"
AWAY_SVG = (
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">'
    '<circle cx="32" cy="32" r="22" fill="none" stroke="{color}" '
    'stroke-width="8" stroke-dasharray="11 6.3"/></svg>\n'
)
LIGHT_IDS = os.environ.get("LUXAFOR_IDS", "04d8:f372").lower().split()
SYSFS = os.environ.get("LUXAFOR_SYSFS", "/sys")
# A dock being unplugged can flicker: wait this many checks (1 s apart)
# before saying the light is gone.
AWAY_AFTER = 2
# Freshly plugged in, the light may not be writable yet (udev): retry.
APPLY_TRIES = 10
OFF_COLOR = "#9e9e9e"

ID_RE = re.compile(r"^[a-z0-9_-]+$")
FALLBACK = [
    ("available", "green", "Available"),
    ("busy", "red", "Busy"),
    ("call", "yellow", "On a call"),
]

SVG = (
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">'
    '<circle cx="32" cy="32" r="26" fill="{color}"/></svg>\n'
)


def config_path():
    return CONF if os.path.isfile(CONF) else DEFAULT_CONF


def config_mtime():
    try:
        return os.path.getmtime(config_path())
    except OSError:
        return None


def load_statuses():
    """Returns [(id, color, label), …] — same rules as luxafor-toggle."""
    statuses = []
    try:
        with open(config_path(), encoding="utf-8") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                parts = [p.strip() for p in line.split("|", 2)]
                if len(parts) < 2 or not parts[1]:
                    continue
                sid, color = parts[0], parts[1]
                if not ID_RE.match(sid) or sid == "off":
                    continue
                label = parts[2] if len(parts) > 2 and parts[2] else sid
                statuses.append((sid, color, label))
    except OSError:
        pass
    if config_path() != CONF:
        # Shipped defaults (no statuses of the user's own yet): translated.
        statuses = [(sid, color, _(label)) for sid, color, label in statuses]
    return statuses or [(sid, color, _(label)) for sid, color, label in FALLBACK]


def setting(key):
    return subprocess.run(
        [TOGGLE, "--setting", key], capture_output=True, text=True, check=False
    ).stdout.strip()


def load_shortcuts():
    """[(status id, minutes)] for the tray menu — see timer-shortcuts."""
    shortcuts = []
    out = subprocess.run(
        [TOGGLE, "--setting", "timer-shortcuts"], capture_output=True, text=True, check=False
    ).stdout
    for line in out.splitlines():
        try:
            sid, minutes = line.split()
            shortcuts.append((sid, int(minutes)))
        except ValueError:
            pass
    return shortcuts


LOG = f"{CACHE_HOME}/luxafor-tray.log"
BUS_NAME = "io.github.nevilledubuis.luxafor_status.tray"


def log(message):
    """Errors go to stderr and to ~/.cache/luxafor-tray.log (kept short):
    started at login, the tray has no terminal to show them."""
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}"
    print(line, file=sys.stderr, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        old = open(LOG).read().splitlines()[-400:] if os.path.exists(LOG) else []
        with open(LOG, "w") as f:
            f.write("\n".join(old + [line]) + "\n")
    except OSError:
        pass


_children = []


def spawn(*args):
    """Starts a command without waiting for it; reap_children() collects it.

    Without that, every closed panel or finished luxafor-toggle would stay
    behind as a zombie process of the tray.
    """
    try:
        # Detached from any terminal the tray was started from: otherwise a
        # child touching that terminal gets suspended by the shell's job
        # control, and whatever waits for it with it.
        _children.append(subprocess.Popen(
            list(args), stdin=subprocess.DEVNULL, start_new_session=True
        ))
    except OSError as e:
        print(f"luxafor-tray: cannot run {args[0]}: {e}", file=sys.stderr)


def reap_children():
    _children[:] = [p for p in _children if p.poll() is None]


def read_state():
    try:
        with open(STATE) as f:
            return f.read().strip() or "off"
    except OSError:
        return "off"


def write_tray_icons(statuses):
    """Writes the icons of each status, light connected or not, and returns
    ({id: icon name}, {id: icon name when the light is away})."""
    os.makedirs(TRAY_ICON_DIR, exist_ok=True)
    for prefix in (TRAY_ICON_PREFIX, AWAY_ICON_PREFIX):
        for old in glob.glob(f"{TRAY_ICON_DIR}/{prefix}*.svg"):
            try:
                os.remove(old)
            except OSError:
                pass
    names, away = {}, {}
    for sid, color, _label in statuses + [("off", OFF_COLOR, "Off")]:
        digest = hashlib.md5(color.encode()).hexdigest()[:6]
        for prefix, svg, table in ((TRAY_ICON_PREFIX, SVG, names), (AWAY_ICON_PREFIX, AWAY_SVG, away)):
            name = f"{prefix}{sid}-{digest}"
            with open(f"{TRAY_ICON_DIR}/{name}.svg", "w") as f:
                f.write(svg.format(color=color))
            table[sid] = name
    return names, away


def light_connected():
    """True if a Luxafor light is plugged in (same lookup as luxafor-light)."""
    for uevent in glob.glob(f"{SYSFS}/class/hidraw/hidraw*/device/uevent"):
        try:
            with open(uevent) as f:
                hid_id = next((l[7:].strip() for l in f if l.startswith("HID_ID=")), "")
        except OSError:
            continue
        parts = hid_id.lower().split(":")  # 0003:000004D8:0000F372
        if len(parts) == 3 and f"{parts[1][-4:]}:{parts[2][-4:]}" in LIGHT_IDS:
            return True
    return False


def notify(text, icon="luxafor-status"):
    if shutil.which("notify-send"):
        spawn("notify-send", "-i", icon, "Luxafor", text)


def read_timer():
    """Returns (end epoch, status id) of the running timer, or None."""
    try:
        with open(TIMER) as f:
            end, status = f.read().split()[:2]
            return int(end), status
    except (OSError, ValueError):
        return None


def human_minutes(minutes):
    if minutes < 60:
        return _("{minutes} min").format(minutes=minutes)
    hours, rest = divmod(minutes, 60)
    if rest == 0:
        return _("{hours} h").format(hours=hours)
    return _("{hours} h {minutes:02d}").format(hours=hours, minutes=rest)


DND_MARK = f"{CACHE_HOME}/luxafor-dnd"


class DesktopDnd:
    """The desktop's "do not disturb" switch, wherever this desktop keeps it.

    Budgie and other desktops keep a boolean "…do-not-disturb…" key in their
    own GSettings schema; GNOME has org.gnome.desktop.notifications
    show-banners (false = do not disturb). Found once, at startup.
    """

    CANDIDATES = (
        "budgie", "raven", "cinnamon", "mate", "xfce", "pantheon", "notifications",
    )

    def __init__(self):
        self.settings, self.key, self.inverted = None, None, False
        source = Gio.SettingsSchemaSource.get_default()
        if not source:
            return
        schemas = source.list_schemas(True)[0]  # non-relocatable only
        for sid in sorted(schemas):
            if not any(c in sid.lower() for c in self.CANDIDATES):
                continue
            schema = source.lookup(sid, True)
            for key in schema.list_keys():
                if ("disturb" in key or key == "dnd") and \
                        schema.get_key(key).get_value_type().dup_string() == "b":
                    self.settings, self.key = Gio.Settings.new(sid), key
                    return
        schema = source.lookup("org.gnome.desktop.notifications", True)
        if schema and schema.has_key("show-banners"):
            self.settings = Gio.Settings.new("org.gnome.desktop.notifications")
            self.key, self.inverted = "show-banners", True

    @property
    def available(self):
        return self.settings is not None

    def describe(self):
        return f"{self.settings.props.schema_id} {self.key}" if self.available else "none"

    def get(self):
        value = self.settings.get_boolean(self.key)
        return not value if self.inverted else value

    def set(self, on):
        self.settings.set_boolean(self.key, not on if self.inverted else on)
        Gio.Settings.sync()


class ScreenLock:
    """Calls on_change(locked) when the screen is locked or unlocked.

    Listens to the screensaver interfaces of the usual desktops (Budgie and
    GNOME: org.gnome.ScreenSaver; KDE…: org.freedesktop.ScreenSaver;
    Cinnamon, MATE) and to logind's LockedHint, whichever speaks first.
    """

    INTERFACES = (
        "org.gnome.ScreenSaver", "org.freedesktop.ScreenSaver",
        "org.cinnamon.ScreenSaver", "org.mate.ScreenSaver",
    )

    def __init__(self, on_change):
        self.on_change = on_change
        self.locked = False
        try:
            session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            for iface in self.INTERFACES:
                session.signal_subscribe(
                    None, iface, "ActiveChanged", None, None,
                    Gio.DBusSignalFlags.NONE, self.on_screensaver,
                )
        except GLib.Error as e:
            log(f"screen lock: no session bus ({e.message})")
        try:
            system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            path = system.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1",
                "org.freedesktop.login1.Manager", "GetSessionByPID",
                GLib.Variant("(u)", (os.getpid(),)), GLib.VariantType("(o)"),
                Gio.DBusCallFlags.NONE, 2000, None,
            ).unpack()[0]
            system.signal_subscribe(
                "org.freedesktop.login1", "org.freedesktop.DBus.Properties",
                "PropertiesChanged", path, None, Gio.DBusSignalFlags.NONE, self.on_logind,
            )
        except GLib.Error:
            pass  # no logind session (tests, containers): screensaver signals only

    def on_screensaver(self, _conn, _sender, _path, _iface, _signal, params):
        self.set(bool(params.unpack()[0]))

    def on_logind(self, _conn, _sender, _path, _iface, _signal, params):
        iface, changed, _invalidated = params.unpack()
        if iface == "org.freedesktop.login1.Session" and "LockedHint" in changed:
            self.set(bool(changed["LockedHint"]))

    def set(self, locked):
        if locked != self.locked:
            self.locked = locked
            try:
                self.on_change(locked)
            except Exception:
                log("error on screen lock change:\n" + traceback.format_exc())


class Tray:
    def __init__(self):
        self.ind = AI.Indicator.new(
            "luxafor-status", "luxafor-status", AI.IndicatorCategory.APPLICATION_STATUS
        )
        self.ind.set_icon_theme_path(TRAY_ICON_DIR)
        self.ind.set_status(AI.IndicatorStatus.ACTIVE)
        self.ind.set_title("Luxafor")
        self.statuses = []
        self.icons = {}
        self.mtime = object()  # forces a first load
        self.last_state = None
        self.timer = None        # (end, status) shown in the menu
        self.timer_item = None   # menu line showing the time left
        self.timer_text = None
        self.away_icons = {}
        # Light: None until the first check. At startup, the light shows
        # whatever it was left with: send it the current status.
        self.connected = None
        self.missing_checks = 0
        self.apply_tries = 0
        self.announce = False    # say "reconnected" once the status is back
        # Screen lock
        self.lock_status = "off"
        self.lock = None         # (status before, timer end) while locked
        self.screen = ScreenLock(self.on_lock)
        # Do not disturb
        self.dnd_statuses = set()
        self.dnd = DesktopDnd()
        self.dnd_state = None
        # Restart a timer that was running before logout, or end it if expired.
        spawn(TOGGLE, "--resume-timer")
        self.tick()
        GLib.timeout_add_seconds(1, self.tick)

    def reload(self):
        # luxafor-toggle refreshes the dock launcher and notification icons.
        subprocess.run(
            [TOGGLE, "--reload"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        self.statuses = load_statuses()
        self.shortcuts = load_shortcuts()
        self.lock_status = setting("lock-status") or "off"
        self.dnd_statuses = set(setting("dnd-statuses").split())
        self.dnd_state = None  # apply the DND setting again
        self.icons, self.away_icons = write_tray_icons(self.statuses)
        self.build_menu()
        self.last_state = None  # force the icon to be set again

    def label_of(self, sid):
        return next((l for s, _c, l in self.statuses if s == sid), _("Off") if sid == "off" else sid)

    def timer_line(self):
        end, status = self.timer
        left = max(0, round((end - time.time()) / 60 + 0.49))
        until = time.strftime("%H:%M", time.localtime(end))
        text = _("{status} until {time} ({left} left)").format(
            status=self.label_of(status), time=until, left=human_minutes(left))
        return f"⏱ {text}", left

    def build_menu(self):
        # Drop the middle-click target first: it belongs to the old menu,
        # which is about to be destroyed.
        self.ind.set_secondary_activate_target(None)
        menu = Gtk.Menu()

        def add(label, args=None, action=None, enabled=True):
            item = Gtk.MenuItem(label=label)
            item.set_sensitive(enabled)
            if args:
                item.connect("activate", lambda _w: spawn(TOGGLE, *args))
            elif action:
                item.connect("activate", lambda _w: action())
            menu.append(item)
            return item

        def separator():
            menu.append(Gtk.SeparatorMenuItem())

        # Light unplugged
        if self.connected is False:
            add("⚠ " + _("Light not connected"), enabled=False)
            separator()

        # Running timer
        self.timer_item = None
        if self.timer:
            self.timer_item = add(self.timer_line()[0], enabled=False)
            add(_("Cancel timer"), ["--cancel-timer"])
            separator()

        # Statuses, in one click
        for sid, _color, label in self.statuses:
            add(label, [sid])
        separator()

        # Timers in one click; "More…": any duration, and the settings
        for sid, minutes in self.shortcuts:
            add(_("{status} for {duration}").format(status=self.label_of(sid), duration=human_minutes(minutes)),
                [sid, "--for", str(minutes)])
        more = add(_("More…"), action=lambda: spawn(PANEL))
        separator()

        # Off isn't a status: the light is just off
        add(_("Off"), ["off"])
        separator()

        add(_("Quit"), action=Gtk.main_quit)
        menu.show_all()
        self.ind.set_menu(menu)
        # Middle-click on the icon opens the panel. Set after set_menu: the
        # target must belong to the menu in use.
        self.ind.set_secondary_activate_target(more)

    def tick(self):
        # An exception escaping a GLib timeout callback removes the timeout:
        # the icon would never update again. Log it and keep going.
        try:
            self.update()
        except Exception:
            log("error while updating:\n" + traceback.format_exc())
        return True

    def update(self):
        mtime = config_mtime()
        if mtime != self.mtime:
            self.mtime = mtime
            self.reload()
        self.update_light()
        state = read_state()
        if state not in self.icons:
            state = "off"
        self.update_dnd(state)
        shown = (state, self.connected)
        if shown != self.last_state:
            if self.connected is False:
                self.ind.set_icon_full(
                    self.away_icons[state],
                    _("{status} — light not connected").format(status=self.label_of(state)))
            else:
                self.ind.set_icon_full(self.icons[state], self.label_of(state))
            self.last_state = shown
        self.update_timer()
        reap_children()

    # --- screen lock -----------------------------------------------------------

    def on_lock(self, locked):
        """Locked: lock-status (off by default). Unlocked: back to the status
        from before, unless it was changed meanwhile (a call, by hand…)."""
        if self.lock_status == "none":
            return
        if locked:
            before = read_state()
            timer = read_timer()
            self.lock = (before, timer[0] if timer else None)
            if before != self.lock_status:
                # --keep-timer: locking the screen doesn't cancel a timer.
                spawn(TOGGLE, self.lock_status, "--keep-timer")
            return
        if not self.lock:
            return
        before, timer_end = self.lock
        self.lock = None
        if read_state() != self.lock_status or before == self.lock_status:
            return
        back = before
        if timer_end and not read_timer() and time.time() >= timer_end:
            back = setting("default-status")  # the timer ended while locked
        spawn(TOGGLE, back, "--keep-timer")

    # --- do not disturb ----------------------------------------------------------

    def update_dnd(self, state):
        """Silences desktop notifications while the status is one of
        dnd-statuses; puts the previous setting back afterwards."""
        want = state in self.dnd_statuses
        if want == self.dnd_state or not self.dnd.available:
            return
        self.dnd_state = want
        if want and not os.path.exists(DND_MARK):
            # Remember the user's own setting (survives a tray restart).
            with open(DND_MARK, "w") as f:
                f.write("1\n" if self.dnd.get() else "0\n")
            self.dnd.set(True)
        elif not want and os.path.exists(DND_MARK):
            with open(DND_MARK) as f:
                previous = f.read().strip() == "1"
            os.remove(DND_MARK)
            self.dnd.set(previous)

    def restore_dnd(self):
        """On quit: never leave notifications silenced behind."""
        if self.dnd.available and os.path.exists(DND_MARK):
            self.dnd_state = None
            self.update_dnd(None)

    def update_light(self):
        """Notices the light being unplugged (laptop leaving its dock) and
        plugged back in, and shows the current status on it again."""
        if light_connected():
            self.missing_checks = 0
            if self.connected is not True:
                self.announce = self.connected is False  # not at startup
                self.connected = True
                self.apply_tries = APPLY_TRIES
                self.build_menu()
        else:
            self.missing_checks += 1
            if self.connected is None or (self.connected and self.missing_checks >= AWAY_AFTER):
                was_connected = self.connected
                self.connected = False
                self.apply_tries = 0
                self.build_menu()
                if was_connected:
                    state = self.label_of(read_state())
                    notify(_("Light disconnected — {status} will be shown again when it's plugged back in")
                           .format(status=state))
        if self.apply_tries:
            self.apply_tries -= 1
            done = subprocess.run(
                [TOGGLE, "--apply"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, check=False, timeout=10,
            ).returncode == 0
            if done:
                self.apply_tries = 0
                if self.announce:
                    notify(_("Light reconnected — {status}").format(status=self.label_of(read_state())))
                    self.announce = False
            elif not self.apply_tries:
                log("could not show the status on the light after it was plugged in")

    def update_timer(self):
        timer = read_timer()
        if timer != self.timer:
            # A timer started or stopped: the menu gains or loses its lines.
            self.timer = timer
            self.timer_text = None
            self.build_menu()
        if not self.timer:
            if self.timer_text != "":
                self.ind.set_label("", "")
                self.timer_text = ""
            return
        text, left = self.timer_line()
        if text != self.timer_text:
            # Updated in place: rebuilding would close an open menu.
            if self.timer_item:
                self.timer_item.set_label(text)
            self.ind.set_label(human_minutes(left), "00 h 00")
            self.timer_text = text


def main():
    """One tray per session. A new one (after an upgrade, or started by hand)
    takes over: the previous one sees the D-Bus name go and quits, so its
    icon goes away instead of staying behind, frozen."""
    state = {"tray": None}

    def acquired(_conn, _name):
        if state["tray"] is None:
            state["tray"] = Tray()

    def lost(_conn, _name):
        if state["tray"] is None:
            log("cannot own the tray bus name — starting anyway")
            state["tray"] = Tray()
        else:
            log("another luxafor-tray took over, quitting")
            Gtk.main_quit()

    Gio.bus_own_name(
        Gio.BusType.SESSION,
        BUS_NAME,
        Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.REPLACE,
        None,
        acquired,
        lost,
    )
    Gtk.main()
    if state["tray"]:
        state["tray"].restore_dnd()


if __name__ == "__main__":
    main()
