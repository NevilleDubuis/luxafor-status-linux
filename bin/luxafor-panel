#!/usr/bin/python3
"""luxafor-panel — a small window to pick a status, optionally for a while.

Status tab: choose a duration (∞ = no timer), then click a status: it is
applied and the panel closes. Keyboard: 1–9 pick a status, Esc closes.

Settings tab: statuses (color, name, order), the status after a timer and
during calls, the timers of the tray menu, and the theme.

Everything goes through luxafor-toggle, so the panel never disagrees with
the tray icon, the launcher or the command line.
"""
import os
import shutil
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

# --- translations ------------------------------------------------------------------

def _translation():
    """Messages in the user's language (gettext domain luxafor-status)."""
    import gettext

    home = os.path.expanduser("~")
    dirs = [
        os.environ.get("LUXAFOR_LOCALEDIR"),
        f"{os.environ.get('XDG_DATA_HOME', home + '/.local/share')}/locale",
        "/usr/local/share/locale",
        "/usr/share/locale",
    ]
    for d in dirs:
        if d and gettext.find("luxafor-status", d):
            return gettext.translation("luxafor-status", d)
    return gettext.NullTranslations()


_ = _translation().gettext

HOME = os.path.expanduser("~")
CACHE_HOME = os.environ.get("XDG_CACHE_HOME", f"{HOME}/.cache")
TIMER = f"{CACHE_HOME}/luxafor-timer"
_HERE = os.path.dirname(os.path.realpath(__file__))
TOGGLE = (
    f"{_HERE}/luxafor-toggle"
    if os.path.isfile(f"{_HERE}/luxafor-toggle")
    else shutil.which("luxafor-toggle") or f"{HOME}/.local/bin/luxafor-toggle"
)

APP_ID = "io.github.nevilledubuis.luxafor_status.panel"
TRAY_BUS_NAME = "io.github.nevilledubuis.luxafor_status.tray"
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config")
OFF_COLOR = "#9e9e9e"
# (minutes, label); None = no timer
DURATIONS = [(None, "∞"), (15, None), (30, None), (60, None), (120, None)]  # labels: human_minutes
CUSTOM_DEFAULT = 45

CSS = b"""
.lx-panel { padding: 14px; }
.lx-heading { font-size: smaller; font-weight: bold; opacity: 0.6; margin-top: 4px; }
.lx-current-name { font-size: larger; font-weight: bold; }
.lx-timer { opacity: 0.75; }
.lx-status { padding: 6px 10px; }
.lx-status.lx-current { box-shadow: inset 0 0 0 2px @theme_selected_bg_color; font-weight: bold; }
.lx-hint { font-size: smaller; opacity: 0.55; }
.lx-switcher { margin-bottom: 6px; }
"""


def toggle_output(*args):
    try:
        return subprocess.run(
            [TOGGLE, *args], capture_output=True, text=True, check=False, timeout=5
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def load_statuses():
    """[(id, color, label)] from `luxafor-toggle --list` (off included)."""
    statuses = []
    for line in toggle_output("--list").splitlines():
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        sid, color = parts[0], parts[1]
        label = parts[2].strip() if len(parts) > 2 else sid
        statuses.append((sid, OFF_COLOR if sid == "off" else color, label))
    return statuses or [("off", OFF_COLOR, "Off")]


def read_timer():
    try:
        with open(TIMER) as f:
            end, status = f.read().split()[:2]
            return int(end), status
    except (OSError, ValueError):
        return None


def human_minutes(minutes):
    if minutes < 60:
        return _("{minutes} min").format(minutes=minutes)
    hours, rest = divmod(minutes, 60)
    if rest == 0:
        return _("{hours} h").format(hours=hours)
    return _("{hours} h {minutes:02d}").format(hours=hours, minutes=rest)


def system_prefers_dark():
    """True if the desktop asks for dark apps (GNOME / Budgie "Style: Dark")."""
    source = Gio.SettingsSchemaSource.get_default()
    schema = source.lookup("org.gnome.desktop.interface", True) if source else None
    if not schema or not schema.has_key("color-scheme"):
        return False
    return Gio.Settings.new("org.gnome.desktop.interface").get_string("color-scheme") == "prefer-dark"


def apply_theme(mode=None):
    """theme = auto | light | dark (statuses.conf).

    auto keeps the desktop's GTK theme — dark themes stay dark — and also
    follows the "prefer dark" desktop setting. light and dark use Adwaita,
    which has both variants, so the choice always takes effect.
    """
    mode = mode or toggle_output("--setting", "theme").strip() or "auto"
    settings = Gtk.Settings.get_default()
    if not hasattr(apply_theme, "desktop"):
        apply_theme.desktop = (
            settings.get_property("gtk-theme-name"),
            settings.get_property("gtk-application-prefer-dark-theme"),
        )
    if mode in ("light", "dark"):
        settings.set_property("gtk-theme-name", "Adwaita")
        settings.set_property("gtk-application-prefer-dark-theme", mode == "dark")
    else:
        name, dark = apply_theme.desktop
        settings.set_property("gtk-theme-name", name)
        settings.set_property("gtk-application-prefer-dark-theme", dark or system_prefers_dark())
    return mode


def sibling(name):
    path = f"{_HERE}/{name}"
    return path if os.path.isfile(path) else shutil.which(name) or name


def autostart_disabled(name):
    """True if the user turned the session autostart of `name` off
    ("Startup Applications" writes an override in ~/.config/autostart)."""
    try:
        with open(f"{CONFIG_HOME}/autostart/{name}.desktop") as f:
            lines = [l.strip() for l in f]
    except OSError:
        return False
    return "Hidden=true" in lines or "X-GNOME-Autostart-enabled=false" in lines


def tray_running():
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        reply = bus.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
            "NameHasOwner", GLib.Variant("(s)", (TRAY_BUS_NAME,)),
            GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, 2000, None,
        )
        return reply.unpack()[0]
    except GLib.Error:
        return True  # can't tell: don't risk starting a second one


def start_background(spawn=None):
    """Starts the tray icon and the call detection if they aren't running —
    after installing the package, they only start at the next login
    otherwise. Returns the names started."""
    spawn = spawn or (lambda path: subprocess.Popen(
        [path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True,
    ))
    started = []
    if not autostart_disabled("luxafor-tray") and not tray_running():
        spawn(sibling("luxafor-tray"))
        started.append("luxafor-tray")
    if not autostart_disabled("luxafor-callwatch"):
        # A second luxafor-callwatch leaves at once if one is running.
        spawn(sibling("luxafor-callwatch"))
        started.append("luxafor-callwatch")
    return started


def dot(color, size="large"):
    label = Gtk.Label()
    label.set_markup(
        f'<span foreground="{GLib.markup_escape_text(color)}" size="{size}">●</span>'
    )
    return label


class Panel(Gtk.ApplicationWindow):
    def __init__(self, app, run=None):
        super().__init__(application=app, title="Luxafor")
        # run(args): how commands are executed — replaced in tests.
        # Detached from any terminal (see spawn() in luxafor-tray).
        self.run = run or (lambda args: subprocess.Popen(
            [TOGGLE, *args], stdin=subprocess.DEVNULL, start_new_session=True
        ))
        self.statuses = load_statuses()
        self.current = (toggle_output("--current").strip() or "off")
        self.minutes = None

        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.MOUSE)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_icon_name("luxafor-status")
        self.connect("key-press-event", self.on_key)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.get_style_context().add_class("lx-panel")
        self.add(outer)
        self.stack = Gtk.Stack()
        self.stack.set_hhomogeneous(False)
        self.stack.set_vhomogeneous(False)
        self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
        self.stack.connect("notify::visible-child", lambda *_a: self.resize(1, 1))
        switcher = Gtk.StackSwitcher(stack=self.stack, halign=Gtk.Align.CENTER)
        switcher.get_style_context().add_class("lx-switcher")
        outer.pack_start(switcher, False, False, 0)
        outer.pack_start(self.stack, True, True, 0)
        self.stack.add_titled(self.build_status_page(), "status", _("Status"))
        self.settings = SettingsPage(on_saved=self.rebuild_status_page)
        # Scrolls on small screens; as tall as needed (up to ~640 px) otherwise.
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_propagate_natural_height(True)
        scroller.set_propagate_natural_width(True)
        scroller.set_max_content_height(620)
        scroller.add(self.settings)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        page.pack_start(scroller, True, True, 0)
        page.pack_start(self.settings.footer, False, False, 0)
        self.stack.add_titled(page, "settings", _("Settings"))

        self.refresh_header()
        GLib.timeout_add_seconds(15, self.refresh_header)

    def build_status_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        # Current status and timer
        head = Gtk.Box(spacing=10)
        self.head_dot = Gtk.Label()
        head.pack_start(self.head_dot, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.head_name = Gtk.Label(xalign=0)
        self.head_name.get_style_context().add_class("lx-current-name")
        self.head_timer = Gtk.Label(xalign=0)
        self.head_timer.get_style_context().add_class("lx-timer")
        text.pack_start(self.head_name, False, False, 0)
        text.pack_start(self.head_timer, False, False, 0)
        head.pack_start(text, True, True, 0)
        self.cancel_button = Gtk.Button(label=_("Cancel timer"))
        self.cancel_button.set_valign(Gtk.Align.CENTER)
        self.cancel_button.connect("clicked", self.on_cancel_timer)
        head.pack_end(self.cancel_button, False, False, 0)
        box.pack_start(head, False, False, 0)
        box.pack_start(Gtk.Separator(), False, False, 4)

        # Duration
        box.pack_start(self.heading(_("1 · DURATION")), False, False, 0)
        durations = Gtk.Box(spacing=0)
        durations.get_style_context().add_class("linked")
        self.duration_buttons = {}
        group = None
        for minutes, label in DURATIONS + [("custom", "")]:
            if minutes == "custom":
                button = Gtk.RadioButton.new_from_widget(group)
                button.set_tooltip_text(_("Custom duration"))
                self.spin = Gtk.SpinButton.new_with_range(1, 1440, 5)
                self.spin.set_value(CUSTOM_DEFAULT)
                self.spin.set_width_chars(4)
                self.spin.connect("value-changed", lambda _s: self.custom_button.set_active(True))
                self.spin.connect("focus-in-event", lambda *_a: self.custom_button.set_active(True))
                inner = Gtk.Box(spacing=4)
                inner.pack_start(self.spin, False, False, 0)
                inner.pack_start(Gtk.Label(label=_("min")), False, False, 0)
                self.custom_button = button
                button.add(inner)
            else:
                button = Gtk.RadioButton.new_with_label_from_widget(group, label or human_minutes(minutes))
            button.set_mode(False)  # look like toggle buttons, not radio dots
            button.connect("toggled", self.on_duration, minutes)
            durations.pack_start(button, False, False, 0)
            self.duration_buttons[minutes] = button
            group = group or button
        box.pack_start(durations, False, False, 0)
        box.pack_start(Gtk.Box(), False, False, 2)

        # Statuses
        box.pack_start(self.heading(_("2 · STATUS")), False, False, 0)
        grid = Gtk.Grid(column_spacing=6, row_spacing=6, column_homogeneous=True)
        self.status_buttons = {}
        for n, (sid, color, label) in enumerate(self.statuses):
            button = Gtk.Button()
            content = Gtk.Box(spacing=8)
            content.pack_start(dot(color), False, False, 0)
            name = Gtk.Label(label=label, xalign=0)
            name.set_ellipsize(Pango.EllipsizeMode.END)
            content.pack_start(name, True, True, 0)
            if n < 9:
                key = Gtk.Label(label=str(n + 1))
                key.get_style_context().add_class("lx-hint")
                content.pack_end(key, False, False, 0)
            button.add(content)
            button.get_style_context().add_class("lx-status")
            if sid == self.current:
                button.get_style_context().add_class("lx-current")
            button.set_tooltip_text(f"luxafor-toggle {sid}")
            button.connect("clicked", self.on_status, sid)
            grid.attach(button, n % 2, n // 2, 1, 1)
            self.status_buttons[sid] = button
        box.pack_start(grid, False, False, 0)

        # Footer
        footer = Gtk.Box(spacing=8)
        hint = Gtk.Label(label=_("Pick a duration, then a status · Esc to close"), xalign=0)
        hint.get_style_context().add_class("lx-hint")
        footer.pack_start(hint, True, True, 0)
        box.pack_start(footer, False, False, 4)
        return box


    def focus_status(self):
        """Opens on the Status tab, keyboard focus on the current status (not
        in the duration field, where 1–9 would type digits)."""
        self.stack.set_visible_child_name("status")
        button = self.status_buttons.get(self.current) or next(iter(self.status_buttons.values()))
        button.grab_focus()

    def rebuild_status_page(self):
        """After the settings are saved: statuses may have changed."""
        self.statuses = load_statuses()
        old = self.stack.get_child_by_name("status")
        self.stack.remove(old)
        old.destroy()
        page = self.build_status_page()
        self.stack.add_titled(page, "status", _("Status"))
        self.stack.child_set_property(page, "position", 0)
        page.show_all()
        self.refresh_header()

    @staticmethod
    def heading(text):
        label = Gtk.Label(label=text, xalign=0)
        label.get_style_context().add_class("lx-heading")
        return label

    def label_of(self, sid):
        return next((l for s, _c, l in self.statuses if s == sid), sid)

    def color_of(self, sid):
        return next((c for s, c, _l in self.statuses if s == sid), OFF_COLOR)

    def refresh_header(self):
        self.head_dot.set_markup(
            f'<span foreground="{GLib.markup_escape_text(self.color_of(self.current))}" '
            f'size="xx-large">●</span>'
        )
        self.head_name.set_text(self.label_of(self.current))
        timer = read_timer()
        if timer:
            end, status = timer
            left = max(0, round((end - time.time()) / 60 + 0.49))
            until = time.strftime("%H:%M", time.localtime(end))
            who = "" if status == self.current else f"{self.label_of(status)} "
            then = toggle_output("--setting", "default-status").strip()
            text = _("until {time} · {left} left, then {status}").format(
                time=until, left=human_minutes(left), status=self.label_of(then))
            self.head_timer.set_text(f"{who}{text}")
            self.head_timer.show()
            self.cancel_button.show()
        else:
            self.head_timer.set_text(_("No timer"))
            self.cancel_button.hide()
        return True

    # --- actions ---------------------------------------------------------------

    def on_duration(self, button, minutes):
        if button.get_active():
            self.minutes = minutes

    def chosen_minutes(self):
        if self.minutes == "custom":
            return int(self.spin.get_value())
        return self.minutes

    def on_status(self, _button, sid):
        args = [sid]
        minutes = self.chosen_minutes()
        if minutes:
            args += ["--for", str(minutes)]
        self.run(args)
        self.close()

    def on_cancel_timer(self, _button):
        self.run(["--cancel-timer"])
        self.close()

    def on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if self.stack.get_visible_child_name() != "status":
            return False
        focus = self.get_focus()
        if isinstance(focus, Gtk.Entry) and focus.has_focus():
            return False  # typing (custom duration)
        name = Gdk.keyval_name(event.keyval) or ""
        if name.startswith("KP_"):
            name = name[3:]
        if len(name) == 1 and name in "123456789":
            n = int(name) - 1
            if n < len(self.statuses):
                self.on_status(None, self.statuses[n][0])
                return True
        return False


# --- settings -------------------------------------------------------------------

CONF = f"{CONFIG_HOME}/luxafor-status/statuses.conf"
KNOWN_SETTINGS = (
    "default-status", "call-status", "lock-status", "dnd-statuses",
    "timer-shortcuts", "brightness", "theme",
)
# Extra choices of the status combo boxes: (key, label)
DONT_CHANGE = ("none", _("Don't change"))
LIGHT_OFF = ("off", _("Light off"))
MAX_SHORTCUTS = 6
THEMES = [("auto", _("Follow the desktop")), ("light", _("Light")), ("dark", _("Dark"))]


def read_settings():
    """What the settings page edits, as luxafor-toggle sees it."""
    statuses = [s for s in load_statuses() if s[0] != "off"]
    ids = [s[0] for s in statuses]
    shortcuts = []
    for line in toggle_output("--setting", "timer-shortcuts").splitlines():
        try:
            sid, minutes = line.split()
            shortcuts.append((sid, int(minutes)))
        except ValueError:
            pass
    try:
        brightness = int(toggle_output("--setting", "brightness").strip())
    except ValueError:
        brightness = 100
    return {
        "statuses": statuses,
        "default-status": toggle_output("--setting", "default-status").strip(),
        "call-status": toggle_output("--setting", "call-status").strip() or "none",
        "lock-status": toggle_output("--setting", "lock-status").strip() or "off",
        "dnd-statuses": toggle_output("--setting", "dnd-statuses").split(),
        "timer-shortcuts": shortcuts,
        "brightness": brightness,
        "theme": toggle_output("--setting", "theme").strip() or "auto",
    }


def other_setting_lines(path=CONF):
    """`key = value` lines the panel doesn't manage, kept as they are."""
    kept = []
    try:
        with open(path, encoding="utf-8") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#") or "|" in line or "=" not in line:
                    continue
                if line.split("=", 1)[0].strip() not in KNOWN_SETTINGS:
                    kept.append(line)
    except OSError:
        pass
    return kept


def make_id(label, taken):
    """A command-line id from a label: "Focus — ne pas déranger" → "focus-ne-pas-deranger"."""
    import unicodedata

    text = unicodedata.normalize("NFKD", label).encode("ascii", "ignore").decode().lower()
    base = "".join(c if c.isalnum() or c in "_-" else "-" for c in text)
    base = "-".join(p for p in base.split("-") if p)[:24].strip("-") or "status"
    if base == "off":
        base = "off-status"
    sid, n = base, 2
    while sid in taken:
        sid, n = f"{base}-{n}", n + 1
    return sid


def write_settings(settings, path=CONF):
    """Writes statuses.conf (a .bak of the previous file is kept)."""
    lines = [
        "# luxafor-status — status configuration",
        "# Edited with Luxafor Panel → Settings. Hand edits work too:",
        "# one status per line, \"id | color | label\", then settings as",
        "# \"key = value\" — see: man luxafor-toggle",
        "",
    ]
    width = max([len(s[0]) for s in settings["statuses"]] + [4])
    for sid, color, label in settings["statuses"]:
        lines.append(f"{sid.ljust(width)} | {color.ljust(8)} | {label}")
    shortcuts = ", ".join(f"{sid} {minutes}" for sid, minutes in settings["timer-shortcuts"])
    lines += [
        "",
        f"default-status = {settings['default-status']}",
        f"call-status = {settings['call-status']}",
        f"lock-status = {settings['lock-status']}",
        f"dnd-statuses = {', '.join(settings['dnd-statuses'])}",
        f"timer-shortcuts = {shortcuts}",
        f"brightness = {settings['brightness']}",
        f"theme = {settings['theme']}",
    ]
    lines += other_setting_lines(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path):
        shutil.copyfile(path, path + ".bak")
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, path)


def rgba(color):
    value = Gdk.RGBA()
    if not value.parse(color):
        value.parse(OFF_COLOR)
    return value


def to_hex(value):
    return "#{:02x}{:02x}{:02x}".format(
        round(value.red * 255), round(value.green * 255), round(value.blue * 255)
    )


def icon_button(icon, tooltip, callback):
    button = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
    button.set_relief(Gtk.ReliefStyle.NONE)
    button.set_tooltip_text(tooltip)
    button.connect("clicked", lambda _b: callback())
    return button


class StatusRow(Gtk.Box):
    """One editable status: color, label, move up/down, delete."""

    def __init__(self, page, sid, color, label):
        super().__init__(spacing=4)
        self.page, self.sid, self.original_color = page, sid, color
        self.color = Gtk.ColorButton.new_with_rgba(rgba(color))
        self.color.set_title(_("Color of “{status}”").format(status=label))
        self.color.connect("color-set", lambda _b: page.changed())
        self.label = Gtk.Entry(text=label)
        self.label.set_width_chars(22)
        self.label.connect("changed", lambda _e: page.changed(statuses=True))
        self.pack_start(self.color, False, False, 0)
        self.pack_start(self.label, True, True, 0)
        self.pack_start(icon_button("go-up-symbolic", _("Move up"), lambda: page.move(self, -1)), False, False, 0)
        self.pack_start(icon_button("go-down-symbolic", _("Move down"), lambda: page.move(self, 1)), False, False, 0)
        self.pack_start(icon_button("user-trash-symbolic", _("Delete"), lambda: page.remove(self)), False, False, 0)

    def value(self):
        """(id or None for a new status, color, label)."""
        chosen = self.color.get_rgba()
        color = self.original_color if chosen.equal(rgba(self.original_color)) else to_hex(chosen)
        return self.sid, color, " ".join(self.label.get_text().split())


class ShortcutRow(Gtk.Box):
    """One timer shortcut of the tray menu: status and duration."""

    def __init__(self, page, sid, minutes):
        super().__init__(spacing=4)
        self.page = page
        self.status = Gtk.ComboBoxText()
        self.status.connect("changed", lambda _c: page.changed())
        self.minutes = Gtk.SpinButton.new_with_range(1, 1440, 5)
        self.minutes.set_value(minutes)
        self.minutes.connect("value-changed", lambda _s: page.changed())
        self.pack_start(self.status, True, True, 0)
        self.pack_start(Gtk.Label(label=_("for")), False, False, 0)
        self.pack_start(self.minutes, False, False, 0)
        self.pack_start(Gtk.Label(label=_("min")), False, False, 0)
        self.pack_start(icon_button("user-trash-symbolic", _("Delete"), lambda: page.remove_shortcut(self)), False, False, 0)
        self.wanted = sid


class SettingsPage(Gtk.Box):
    """Statuses (color, label, order), default and call status, timer
    shortcuts and theme — saved to statuses.conf."""

    def __init__(self, on_saved=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.on_saved = on_saved
        self.loading = False

        # Statuses
        self.pack_start(Panel.heading(_("STATUSES")), False, False, 0)
        self.rows_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.pack_start(self.rows_box, False, False, 0)  # the whole page scrolls
        add = Gtk.Button(label=_("Add status"))
        add.set_halign(Gtk.Align.START)
        add.connect("clicked", lambda _b: self.add_status())
        self.pack_start(add, False, False, 0)

        # Default and call status, theme
        grid = Gtk.Grid(column_spacing=10, row_spacing=6)
        self.default_combo = Gtk.ComboBoxText()
        self.call_combo = Gtk.ComboBoxText()
        self.lock_combo = Gtk.ComboBoxText()
        self.theme_combo = Gtk.ComboBoxText()
        for value, text in THEMES:
            self.theme_combo.append(value, text)
        for combo in (self.default_combo, self.call_combo, self.lock_combo, self.theme_combo):
            combo.connect("changed", lambda _c: self.changed())
        self.theme_combo.connect("changed", self.on_theme)
        self.brightness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 5)
        self.brightness.set_value_pos(Gtk.PositionType.RIGHT)
        self.brightness.connect("format-value", lambda _s, v: f"{int(v)} %")
        self.brightness.connect("value-changed", lambda _s: self.changed())
        for n, (text, combo, tip) in enumerate([
            (_("After a timer"), self.default_combo, _("Status to go back to when a timer ends")),
            (_("During calls"), self.call_combo, _("Status used automatically while you are in a call")),
            (_("Screen locked"), self.lock_combo,
             _("Status while the screen is locked; the previous one comes back when you unlock")),
            (_("Brightness"), self.brightness, _("Brightness of the light")),
            (_("Theme"), self.theme_combo, _("Look of this panel")),
        ]):
            label = Gtk.Label(label=text, xalign=0)
            label.set_tooltip_text(tip)
            combo.set_tooltip_text(tip)
            combo.set_hexpand(True)
            grid.attach(label, 0, n, 1, 1)
            grid.attach(combo, 1, n, 1, 1)
        self.pack_start(Gtk.Box(), False, False, 2)
        self.pack_start(Panel.heading(_("BEHAVIOR")), False, False, 0)
        self.pack_start(grid, False, False, 0)

        # Do not disturb
        self.pack_start(Gtk.Box(), False, False, 2)
        self.pack_start(Panel.heading(_("DO NOT DISTURB")), False, False, 0)
        hint = Gtk.Label(label=_("Silence desktop notifications while:"), xalign=0)
        hint.set_tooltip_text(_("Optional: you may still want to see incoming call notifications"))
        self.pack_start(hint, False, False, 0)
        self.dnd_box = Gtk.FlowBox()
        self.dnd_box.set_selection_mode(Gtk.SelectionMode.NONE)
        self.dnd_box.set_max_children_per_line(2)
        self.dnd_box.set_homogeneous(True)
        self.pack_start(self.dnd_box, False, False, 0)

        # Timer shortcuts
        self.pack_start(Gtk.Box(), False, False, 2)
        self.pack_start(Panel.heading(_("TIMERS IN THE TRAY MENU")), False, False, 0)
        self.shortcuts_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.pack_start(self.shortcuts_box, False, False, 0)
        self.add_shortcut_button = Gtk.Button(label=_("Add timer"))
        self.add_shortcut_button.set_halign(Gtk.Align.START)
        self.add_shortcut_button.connect("clicked", lambda _b: self.add_shortcut())
        self.pack_start(self.add_shortcut_button, False, False, 0)

        # Buttons
        bottom = Gtk.Box(spacing=8)
        edit = Gtk.LinkButton.new_with_label("", _("Edit the file…"))
        edit.set_tooltip_text(CONF)
        edit.connect("activate-link", self.on_edit_file)
        bottom.pack_start(edit, False, False, 0)
        self.message = Gtk.Label(xalign=1)
        self.message.set_line_wrap(True)
        self.message.set_max_width_chars(28)
        self.message.get_style_context().add_class("lx-hint")
        bottom.pack_start(self.message, True, True, 0)
        self.revert_button = Gtk.Button(label=_("Revert"))
        self.revert_button.connect("clicked", lambda _b: self.load())
        self.save_button = Gtk.Button(label=_("Save"))
        self.save_button.get_style_context().add_class("suggested-action")
        self.save_button.connect("clicked", lambda _b: self.save())
        bottom.pack_end(self.save_button, False, False, 0)
        bottom.pack_end(self.revert_button, False, False, 0)
        # Packed by the panel below the scrolling page, so Save stays visible.
        self.footer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.footer.pack_start(Gtk.Separator(), False, False, 6)
        self.footer.pack_start(bottom, False, False, 0)

        self.load()

    # --- loading ---------------------------------------------------------------

    def load(self):
        self.loading = True
        settings = read_settings()
        for child in (self.rows_box.get_children() + self.shortcuts_box.get_children()
                      + self.dnd_box.get_children()):
            child.destroy()
        for combo in (self.default_combo, self.call_combo, self.lock_combo):
            combo.remove_all()  # choices come back from the loaded settings
        for sid, color, label in settings["statuses"]:
            self.rows_box.pack_start(StatusRow(self, sid, color, label), False, False, 0)
        for sid, minutes in settings["timer-shortcuts"]:
            self.shortcuts_box.pack_start(ShortcutRow(self, sid, minutes), False, False, 0)
        self.theme_combo.set_active_id(settings["theme"])
        self.brightness.set_value(settings["brightness"])
        self.wanted = {
            "default": settings["default-status"],
            "call": settings["call-status"],
            "lock": settings["lock-status"],
            "dnd": set(settings["dnd-statuses"]),
        }
        self.refresh_choices()
        self.show_all()
        self.loading = False
        self.set_dirty(False)
        self.message.set_text("")

    # --- editing ---------------------------------------------------------------

    def rows(self):
        return self.rows_box.get_children()

    def shortcut_rows(self):
        return self.shortcuts_box.get_children()

    def choices(self):
        """[(key, label)] for the combo boxes: the id for existing statuses,
        the row itself (as a string key) for new ones."""
        return [(row.sid or f"new:{id(row)}", row.value()[2] or _("(no name)")) for row in self.rows()]

    def refresh_choices(self):
        """Fills the status combo boxes, keeping what was chosen when possible."""
        was_loading, self.loading = self.loading, True
        choices = self.choices()
        keys = [k for k, _l in choices]
        combos = [
            ("default", self.default_combo, [], []),
            ("call", self.call_combo, [], [DONT_CHANGE]),
            ("lock", self.lock_combo, [LIGHT_OFF], [DONT_CHANGE]),
        ]
        combos += [(row, row.status, [], []) for row in self.shortcut_rows()]
        for name, combo, before, after in combos:
            current = combo.get_active_id()
            if current is None:
                current = self.wanted[name] if isinstance(name, str) else name.wanted
            combo.remove_all()
            entries = before + choices + after
            for key, label in entries:
                combo.append(key, label)
            if current in [k for k, _l in entries]:
                combo.set_active_id(current)
            elif entries:
                combo.set_active(0)

        # Do-not-disturb check boxes, one per status
        checked = {c.key for c in self.dnd_checks() if c.get_active()} if self.dnd_checks() \
            else self.wanted["dnd"]
        for child in self.dnd_box.get_children():
            child.destroy()
        for key, label in choices:
            check = Gtk.CheckButton(label=label)
            check.key = key
            check.set_active(key in checked)
            check.connect("toggled", lambda _c: self.changed())
            self.dnd_box.add(check)
        self.dnd_box.show_all()
        self.loading = was_loading

    def dnd_checks(self):
        return [child.get_child() for child in self.dnd_box.get_children()]

    def changed(self, statuses=False):
        if self.loading:
            return
        if statuses:
            self.refresh_choices()
        self.set_dirty(True)

    def set_dirty(self, dirty):
        self.dirty = dirty
        self.save_button.set_sensitive(dirty)
        self.revert_button.set_sensitive(dirty)
        if dirty:
            self.message.set_text("")
        self.add_shortcut_button.set_sensitive(len(self.shortcut_rows()) < MAX_SHORTCUTS)

    def add_status(self):
        row = StatusRow(self, None, "#ffffff", "")
        self.rows_box.pack_start(row, False, False, 0)
        row.show_all()
        row.label.grab_focus()
        self.changed(statuses=True)

    def move(self, row, step):
        rows = self.rows()
        n = rows.index(row) + step
        if 0 <= n < len(rows):
            self.rows_box.reorder_child(row, n)
            self.changed(statuses=True)

    def remove(self, row):
        if len(self.rows()) <= 1:
            self.message.set_text(_("Keep at least one status."))
            return
        row.destroy()
        self.changed(statuses=True)

    def add_shortcut(self):
        if len(self.shortcut_rows()) >= MAX_SHORTCUTS:
            return
        row = ShortcutRow(self, None, 30)
        self.shortcuts_box.pack_start(row, False, False, 0)
        self.refresh_choices()
        row.show_all()
        self.changed()

    def remove_shortcut(self, row):
        row.destroy()
        self.changed()

    def on_theme(self, combo):
        if not self.loading and combo.get_active_id():
            apply_theme(combo.get_active_id())

    def on_edit_file(self, _button):
        subprocess.Popen(
            [TOGGLE, "--edit", "--gui"], stdin=subprocess.DEVNULL, start_new_session=True
        )
        return True

    # --- saving ----------------------------------------------------------------

    def collect(self):
        """The settings to write, or an error message."""
        for row in self.rows():
            row.label.get_style_context().remove_class("error")
        empty = [row for row in self.rows() if not row.value()[2]]
        if empty:
            for row in empty:
                row.label.get_style_context().add_class("error")
            empty[0].label.grab_focus()
            return _("Give every status a name.")
        taken = {row.sid for row in self.rows() if row.sid}
        keys, statuses = {}, []
        for row in self.rows():
            sid, color, label = row.value()
            if sid is None:
                sid = make_id(label, taken)
                taken.add(sid)
            keys[row.sid or f"new:{id(row)}"] = sid
            statuses.append((sid, color, label))
        return {
            "statuses": statuses,
            "default-status": keys.get(self.default_combo.get_active_id(), statuses[0][0]),
            "call-status": keys.get(self.call_combo.get_active_id(), self.call_combo.get_active_id() or "none"),
            "lock-status": keys.get(self.lock_combo.get_active_id(), self.lock_combo.get_active_id() or "off"),
            "dnd-statuses": [keys[c.key] for c in self.dnd_checks() if c.get_active() and c.key in keys],
            "brightness": int(self.brightness.get_value()),
            "timer-shortcuts": [
                (keys[r.status.get_active_id()], int(r.minutes.get_value()))
                for r in self.shortcut_rows() if r.status.get_active_id() in keys
            ],
            "theme": self.theme_combo.get_active_id() or "auto",
        }

    def save(self):
        settings = self.collect()
        if isinstance(settings, str):
            self.message.set_text(settings)
            return False
        try:
            write_settings(settings)
        except OSError as e:
            self.message.set_text(_("Could not save: {error}").format(error=e.strerror))
            return False
        # Icons and launcher actions; the tray picks the file up by itself.
        toggle_output("--reload")
        toggle_output("--apply")  # new color or brightness of the current status
        apply_theme(settings["theme"])
        self.load()
        self.message.set_text(_("Saved."))
        if self.on_saved:
            self.on_saved()
        return True


class App(Gtk.Application):
    def __init__(self):
        # A second launch brings the open panel to the front.
        super().__init__(application_id=APP_ID)
        self.window = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        apply_theme()
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def do_activate(self):
        try:
            start_background()
        except OSError as e:
            print(f"luxafor-panel: cannot start the tray or call detection: {e}", file=sys.stderr)
        if not self.window:
            self.window = Panel(self)
            self.window.show_all()
            self.window.refresh_header()  # hides "Cancel timer" if there's no timer
            self.window.focus_status()
        self.window.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
