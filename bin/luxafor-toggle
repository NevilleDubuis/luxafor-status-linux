#!/usr/bin/env bash
# luxafor-toggle — set the status of a Luxafor light.
#
#   luxafor-toggle                  cycle: first status → … → last status → off
#   luxafor-toggle <id>             set a status by its id (see --list), or "off"
#   luxafor-toggle <id> --for 30    set a status for 30 minutes (also 45m, 1h, 1h30),
#                                   then go back to the default status
#   luxafor-toggle --timer          show the running timer
#   luxafor-toggle --cancel-timer   stop the timer, keep the current status
#   luxafor-toggle --list           list configured statuses
#   luxafor-toggle --list-effects   print "<id> <effect>" for each status
#   luxafor-toggle --settings       show the settings (default and call status)
#   luxafor-toggle --current        print the current status id
#   luxafor-toggle --apply          show the current status on the light again
#                                   (after plugging it back in)
#   luxafor-toggle --edit           edit the configuration file (or use the
#                                   Settings tab of luxafor-panel)
#   luxafor-toggle --reload         regenerate icons and launcher after editing
set -u

# --- translations (gettext domain luxafor-status) -----------------------------
TEXTDOMAIN=luxafor-status
TEXTDOMAINDIR=""
for _dir in "${LUXAFOR_LOCALEDIR:-}" "${XDG_DATA_HOME:-$HOME/.local/share}/locale" \
            /usr/local/share/locale /usr/share/locale; do
    if [ -n "$_dir" ] && compgen -G "$_dir/*/LC_MESSAGES/$TEXTDOMAIN.mo" >/dev/null; then
        TEXTDOMAINDIR="$_dir"; break
    fi
done
export TEXTDOMAIN TEXTDOMAINDIR
# t "text": translated text. tf "format" args…: translated printf format.
t() {
    if [ -n "$TEXTDOMAINDIR" ] && command -v gettext >/dev/null 2>&1; then gettext "$1"
    else printf '%s' "$1"; fi
}
tf() {
    local format
    format="$(t "$1")"; shift
    # shellcheck disable=SC2059  # the format is the (translated) message
    printf -- "$format" "$@"
}

BINDIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

CONF="$CONFIG_HOME/luxafor-status/statuses.conf"
# Default statuses: per-user install (~/.local/share) or package (/usr/share).
find_default_conf() {
    local d IFS=:
    # shellcheck disable=SC2086  # split XDG_DATA_DIRS on ":"
    for d in "$DATA_HOME" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
        if [ -f "$d/luxafor-status/statuses.conf" ]; then
            echo "$d/luxafor-status/statuses.conf"; return
        fi
    done
    echo "$DATA_HOME/luxafor-status/statuses.conf"
}
DEFAULT_CONF="$(find_default_conf)"
STATE="$CACHE_HOME/luxafor-state"
# Running timer: "<end epoch> <status id>". Removed when the timer ends or
# when the status is changed by hand.
TIMER="$CACHE_HOME/luxafor-timer"
ICON_DIR="$DATA_HOME/luxafor-status/icons"
DESKTOP_FILE="$DATA_HOME/applications/luxafor.desktop"
OFF_COLOR="#9e9e9e"

# --- helpers ------------------------------------------------------------------

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -t 1500 -i "${2:-luxafor-status}" "Luxafor" "$1" 2>/dev/null || true
}

die() { echo "luxafor-toggle: $1" >&2; notify "$1"; exit "${2:-1}"; }

# Effects a status can have (4th field): steady (default) or blinking.
EFFECTS_ALL="steady blink blink-slow blink-fast"
is_effect() { [[ " $EFFECTS_ALL " == *" $1 "* ]]; }

# Loads statuses into IDS / COLORS / LABELS / EFFECTS (parallel arrays), and
# the settings ("key = value" lines) into SET_DEFAULT / SET_CALL….
load_statuses() {
    IDS=(); COLORS=(); LABELS=(); EFFECTS=(); SET_DEFAULT=""; SET_CALL=""; SET_THEME=""; SET_SHORTCUTS="-"
    SET_LOCK=""; SET_DND=""; SET_BRIGHTNESS=""; SET_APPS=""
    local file="$CONF" line id color label effect key value n=0
    local own=1
    [ -f "$file" ] || { file="$DEFAULT_CONF"; own=0; }
    if [ ! -f "$file" ]; then
        IDS=(available busy call); COLORS=(green red yellow); EFFECTS=(steady steady steady)
        LABELS=("$(t Available)" "$(t Busy)" "$(t "On a call")"); resolve_settings; return
    fi
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line="$(trim "$line")"
        case "$line" in ''|\#*) continue ;; esac
        if [[ "$line" != *"|"* && "$line" == *"="* ]]; then
            key="$(trim "${line%%=*}")"; value="$(trim "${line#*=}")"
            value="$(trim "${value%%#*}")"
            case "$key" in
                default-status) SET_DEFAULT="$value" ;;
                call-status)    SET_CALL="$value" ;;
                theme)          SET_THEME="$value" ;;
                timer-shortcuts) SET_SHORTCUTS="$value" ;;
                lock-status)    SET_LOCK="$value" ;;
                dnd-statuses)   SET_DND="$value" ;;
                brightness)     SET_BRIGHTNESS="$value" ;;
                call-apps)      SET_APPS="$value" ;;
                *) [ "$VERBOSE" -eq 1 ] && echo "luxafor-toggle: unknown setting '$key' on line $n in $file" >&2 ;;
            esac
            continue
        fi
        IFS='|' read -r id color label <<< "$line"
        id="$(trim "$id")"; color="$(trim "${color:-}")"; label="$(trim "${label:-}")"
        if ! [[ "$id" =~ ^[a-z0-9_-]+$ ]] || [ "$id" = off ] || [ -z "$color" ]; then
            [ "$VERBOSE" -eq 1 ] && echo "luxafor-toggle: ignoring invalid line $n in $file: $line" >&2
            continue
        fi
        # "id | color | label | effect": the last field is the effect if it
        # is one (labels may contain "|" themselves).
        effect=steady
        if [[ "$label" == *"|"* ]] && is_effect "$(trim "${label##*|}")"; then
            effect="$(trim "${label##*|}")"; label="$(trim "${label%|*}")"
        fi
        label="${label:-$id}"
        # Shipped defaults (no statuses of the user's own yet): translated.
        [ "$own" -eq 1 ] || label="$(t "$label")"
        IDS+=("$id"); COLORS+=("$color"); LABELS+=("$label"); EFFECTS+=("$effect")
    done < "$file"
    [ "${#IDS[@]}" -gt 0 ] || die "no valid status in $file"
    resolve_settings
}

# DEFAULT_STATUS: where a timer goes back to — the "default-status" setting,
# else "available", else the first status.
resolve_settings() {
    if [ -n "$SET_DEFAULT" ] && { [ "$SET_DEFAULT" = off ] || index_of "$SET_DEFAULT" >/dev/null; }; then
        DEFAULT_STATUS="$SET_DEFAULT"
    else
        if [ -n "$SET_DEFAULT" ] && [ "$VERBOSE" -eq 1 ]; then
            echo "luxafor-toggle: default-status '$SET_DEFAULT' is not one of your statuses" >&2
        fi
        if index_of available >/dev/null; then DEFAULT_STATUS=available; else DEFAULT_STATUS="${IDS[0]}"; fi
    fi
    case "${SET_THEME:-auto}" in
        auto|light|dark) THEME="${SET_THEME:-auto}" ;;
        *) THEME=auto
           [ "$VERBOSE" -eq 1 ] && echo "luxafor-toggle: theme '$SET_THEME' should be auto, light or dark" >&2 ;;
    esac
    resolve_shortcuts

    # CALL_STATUS: status during calls, or "none" (no call detection).
    if [ "$SET_CALL" = none ] || { [ -n "$SET_CALL" ] && index_of "$SET_CALL" >/dev/null; }; then
        CALL_STATUS="$SET_CALL"
    else
        if [ -n "$SET_CALL" ] && [ "$VERBOSE" -eq 1 ]; then
            echo "luxafor-toggle: call-status '$SET_CALL' is not one of your statuses" >&2
        fi
        if index_of call >/dev/null; then CALL_STATUS=call; else CALL_STATUS=none; fi
    fi

    # LOCK_STATUS: status while the screen is locked, "off", or "none" (leave
    # the status alone). Default: off.
    if [ "$SET_LOCK" = none ] || [ "$SET_LOCK" = off ] || { [ -n "$SET_LOCK" ] && index_of "$SET_LOCK" >/dev/null; }; then
        LOCK_STATUS="$SET_LOCK"
    else
        if [ -n "$SET_LOCK" ] && [ "$VERBOSE" -eq 1 ]; then
            echo "luxafor-toggle: lock-status '$SET_LOCK' is not one of your statuses" >&2
        fi
        LOCK_STATUS=off
    fi

    # DND_STATUSES: statuses during which desktop notifications are silenced.
    DND_STATUSES=()
    local d
    for d in ${SET_DND//,/ }; do
        if index_of "$d" >/dev/null; then DND_STATUSES+=("$d")
        elif [ "$VERBOSE" -eq 1 ]; then
            echo "luxafor-toggle: dnd-statuses: '$d' is not one of your statuses" >&2
        fi
    done

    # BRIGHTNESS: 5–100 %.
    if [[ "$SET_BRIGHTNESS" =~ ^[0-9]+$ ]] && [ "$SET_BRIGHTNESS" -ge 5 ] && [ "$SET_BRIGHTNESS" -le 100 ]; then
        BRIGHTNESS="$SET_BRIGHTNESS"
    else
        if [ -n "$SET_BRIGHTNESS" ] && [ "$VERBOSE" -eq 1 ]; then
            echo "luxafor-toggle: brightness '$SET_BRIGHTNESS' should be a percentage from 5 to 100" >&2
        fi
        BRIGHTNESS=100
    fi

    # CALL_APPS: applications that count as "in a call" when recording.
    CALL_APPS="${SET_APPS:-firefox chrome chromium brave msedge edge vivaldi opera epiphany falkon}"
}

# SHORTCUTS: "<id> <minutes>" entries for the tray menu, from
# "timer-shortcuts = busy 30, busy 1h, focus 1h30". Without the setting:
# the first status that isn't the default one, for 30 min and 1 h.
# An empty setting ("timer-shortcuts =") means no shortcuts.
resolve_shortcuts() {
    SHORTCUTS=()
    local spec entry id dur secs i
    if [ "$SET_SHORTCUTS" = "-" ]; then
        spec=""
        for i in "${!IDS[@]}"; do
            if [ "${IDS[$i]}" != "$DEFAULT_STATUS" ]; then
                spec="${IDS[$i]} 30, ${IDS[$i]} 60"; break
            fi
        done
    else
        spec="$SET_SHORTCUTS"
    fi
    IFS=',' read -ra entries <<< "$spec"
    for entry in "${entries[@]}"; do
        read -r id dur _ <<< "$entry"
        [ -n "$id" ] || continue
        if index_of "$id" >/dev/null && secs="$(parse_duration "${dur:-}")"; then
            SHORTCUTS+=("$id $((secs / 60))")
        elif [ "$VERBOSE" -eq 1 ]; then
            echo "luxafor-toggle: ignoring timer shortcut '$(trim "$entry")' — use: <status> <duration>, e.g. busy 30" >&2
        fi
    done
}

label_of() {
    local i
    if [ "$1" = off ]; then
        t Off
        echo
    elif i="$(index_of "$1")"; then
        echo "${LABELS[$i]}"
    else
        echo "$1"
    fi
}

index_of() {
    local i
    for i in "${!IDS[@]}"; do [ "${IDS[$i]}" = "$1" ] && { echo "$i"; return 0; }; done
    return 1
}

find_driver() {
    LIGHT="$BINDIR/luxafor-light"
    [ -x "$LIGHT" ] || LIGHT="$(command -v luxafor-light || true)"
    [ -n "$LIGHT" ] || die "'luxafor-light' not found — re-run install.sh"
}

desktop_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g'; }

# Regenerates the status icons and the launcher's right-click actions.
reload() {
    local i id actions=""
    mkdir -p "$ICON_DIR" "$(dirname "$DESKTOP_FILE")"
    rm -f "$ICON_DIR"/luxafor-*.svg
    for i in "${!IDS[@]}"; do
        printf '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="%s"/></svg>\n' \
            "${COLORS[$i]}" > "$ICON_DIR/luxafor-${IDS[$i]}.svg"
        actions+="${IDS[$i]};"
    done
    printf '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="%s"/></svg>\n' \
        "$OFF_COLOR" > "$ICON_DIR/luxafor-off.svg"

    {
        echo "[Desktop Entry]"
        echo "Type=Application"
        echo "Name=Luxafor"
        echo "Comment=$(t "Change the Luxafor light status")"
        echo "Exec=$BINDIR/luxafor-toggle"
        echo "Icon=luxafor-status"
        echo "Terminal=false"
        echo "Categories=Utility;"
        echo "Keywords=luxafor;busylight;status;"
        echo "Actions=panel;${actions}off;"
        printf '\n[Desktop Action panel]\nName=%s\nExec=%s/luxafor-panel\n' "$(t "Open panel…")" "$BINDIR"
        for i in "${!IDS[@]}"; do
            id="${IDS[$i]}"
            printf '\n[Desktop Action %s]\nName=%s\nExec=%s/luxafor-toggle %s\n' \
                "$id" "$(desktop_escape "${LABELS[$i]}")" "$BINDIR" "$id"
        done
        printf '\n[Desktop Action off]\nName=%s\nExec=%s/luxafor-toggle off\n' "$(t Off)" "$BINDIR"
    } > "$DESKTOP_FILE"
    command -v update-desktop-database >/dev/null 2>&1 \
        && update-desktop-database "$(dirname "$DESKTOP_FILE")" >/dev/null 2>&1
    return 0
}

# edit_config [--gui]: an editor in the terminal, or the desktop's text
# editor with --gui (what the tray and the panel use) or without a terminal.
edit_config() {
    if [ ! -f "$CONF" ]; then
        mkdir -p "$(dirname "$CONF")"
        if [ -f "$DEFAULT_CONF" ]; then cp "$DEFAULT_CONF" "$CONF"
        else die "default configuration not found — re-run install.sh"; fi
    fi
    if [ "${1:-}" != --gui ] && [ -t 0 ] && [ -t 1 ]; then
        "${VISUAL:-${EDITOR:-nano}}" "$CONF"
        VERBOSE=1; load_statuses; reload
        echo "Statuses reloaded."
    else
        # Desktop editor, fully detached so it outlives this command and its
        # terminal. The tray reloads automatically once the file is saved.
        if command -v setsid >/dev/null 2>&1; then
            setsid xdg-open "$CONF" >/dev/null 2>&1 < /dev/null &
        else
            nohup xdg-open "$CONF" >/dev/null 2>&1 < /dev/null &
        fi
    fi
}

# --- timer --------------------------------------------------------------------

# Prints a duration in seconds: 30 (minutes), 30m, 45min, 1h, 1h30, 1h30m.
parse_duration() {
    local d m=0
    d="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
    if   [[ "$d" =~ ^([0-9]+)(m|min)?$ ]];                then m=$((10#${BASH_REMATCH[1]}))
    elif [[ "$d" =~ ^([0-9]+)h$ ]];                       then m=$((10#${BASH_REMATCH[1]} * 60))
    elif [[ "$d" =~ ^([0-9]+)h([0-9]+)(m|min)?$ ]];       then m=$((10#${BASH_REMATCH[1]} * 60 + 10#${BASH_REMATCH[2]}))
    else return 1; fi
    [ "$m" -ge 1 ] && [ "$m" -le 1440 ] || return 1
    echo $((m * 60))
}

human_minutes() {  # seconds → "25 min" / "1 h" / "1 h 30"
    local m=$(( ($1 + 59) / 60 ))
    # (one call per line: xgettext only sees calls at the start of a line)
    if [ "$m" -lt 60 ]; then
        tf '%d min' "$m"
    elif [ $((m % 60)) -eq 0 ]; then
        tf '%d h' $((m / 60))
    else
        tf '%d h %02d' $((m / 60)) $((m % 60))
    fi
    echo
}

# Starts the background process that ends the timer. It sleeps in short
# steps against the wall clock, so a suspended laptop doesn't delay it.
start_timer_watcher() {
    local token="$1"
    stop_timer_watchers
    if command -v setsid >/dev/null 2>&1; then
        setsid "$BINDIR/luxafor-toggle" --timer-expire "$token" >/dev/null 2>&1 < /dev/null &
    else
        nohup "$BINDIR/luxafor-toggle" --timer-expire "$token" >/dev/null 2>&1 < /dev/null &
    fi
}

stop_timer_watchers() {
    pkill -u "$(id -u)" -f "^[^ ]*bash $BINDIR/luxafor-toggle --timer-expire" >/dev/null 2>&1 || true
}

timer_expire() {
    local token="$1" end status now
    read -r end status <<< "$token"
    while :; do
        [ "$(cat "$TIMER" 2>/dev/null)" = "$token" ] || exit 0   # cancelled or replaced
        now="$(date +%s)"
        [ "$now" -lt "$end" ] || break
        sleep $(( end - now < 20 ? end - now : 20 ))
    done
    finish_timer "$token"
}

# Ends a timer: back to the default status if the timer's status is still on.
# If another status took over (a call, for instance), leave it alone:
# luxafor-callwatch goes back to the default status itself after the call.
finish_timer() {
    local end status
    read -r end status <<< "$1"
    [ "$(cat "$TIMER" 2>/dev/null)" = "$1" ] || return 0
    rm -f "$TIMER"
    if [ "$(cat "$STATE" 2>/dev/null || echo off)" = "$status" ]; then
        set_status "$DEFAULT_STATUS" "$(tf 'Timer ended — %s' "$(label_of "$DEFAULT_STATUS")")"
    fi
}

show_timer() {
    local end status now
    if ! read -r end status 2>/dev/null < "$TIMER"; then
        t "No timer."
        echo
        return
    fi
    now="$(date +%s)"
    tf '%s until %s (%s left), then %s\n' "$(label_of "$status")" \
        "$(date -d "@$end" +%H:%M)" "$(human_minutes $(( end > now ? end - now : 0 )))" \
        "$(label_of "$DEFAULT_STATUS")"
}

# --- setting a status ---------------------------------------------------------

# light <id>: sends a status to the light. Returns luxafor-light's status
# (3: no light connected); its message is left in ERR.
light() {
    local i
    find_driver
    if [ "$1" = off ]; then
        ERR="$("$LIGHT" off 2>&1)"
    else
        i="$(index_of "$1")"
        if [ "${EFFECTS[$i]}" = steady ]; then
            ERR="$(LUXAFOR_BRIGHTNESS="$BRIGHTNESS" "$LIGHT" "${COLORS[$i]}" 2>&1)"
        else
            ERR="$(LUXAFOR_BRIGHTNESS="$BRIGHTNESS" "$LIGHT" "${COLORS[$i]}" "${EFFECTS[$i]}" 2>&1)"
        fi
    fi
}

# set_status <id> [notification text]
# Without a light (laptop away from its dock), the status is still kept:
# the tray shows it on the light when it's plugged back in.
set_status() {
    local id="$1" label rc=0
    light "$id" || rc=$?
    label="${2:-$(label_of "$id")}"
    if [ "$rc" -eq 3 ]; then
        label="$(tf '%s — light not connected' "$label")"
        echo "luxafor-toggle: no light connected: '$id' will be shown when it's plugged back in" >&2
    elif [ "$rc" -ne 0 ]; then
        die "${ERR#luxafor-light: }"
    fi
    mkdir -p "$(dirname "$STATE")"
    echo "$id" > "$STATE"
    local icon="$ICON_DIR/luxafor-$id.svg"
    [ -f "$icon" ] || icon=luxafor-status
    notify "$label" "$icon"
}

# --- main ---------------------------------------------------------------------

case "${1:-}" in
    -h|--help)
        sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --edit)
        edit_config "${2:-}"; exit 0 ;;
esac

VERBOSE=0
case "${1:-}" in --list|--reload|--settings) VERBOSE=1 ;; esac
load_statuses

# Options can come before or after the status id.
NEXT=""; DURATION=""; KEEP_TIMER=0
while [ $# -gt 0 ]; do
    case "$1" in
        --list)
            for i in "${!IDS[@]}"; do printf '%-12s %-10s %s\n' "${IDS[$i]}" "${COLORS[$i]}" "${LABELS[$i]}"; done
            printf '%-12s %-10s %s\n' off - "$(t Off)"
            exit 0 ;;
        --list-effects)
            for i in "${!IDS[@]}"; do printf '%s %s\n' "${IDS[$i]}" "${EFFECTS[$i]}"; done
            exit 0 ;;
        --current)
            cat "$STATE" 2>/dev/null || echo off; exit 0 ;;
        --apply)
            CUR="$(cat "$STATE" 2>/dev/null || echo off)"
            if [ "$CUR" != off ] && ! index_of "$CUR" >/dev/null; then CUR=off; fi
            rc=0; light "$CUR" || rc=$?
            [ "$rc" -eq 0 ] || echo "${ERR}" >&2
            exit "$rc" ;;
        --reload)
            reload; echo "Statuses reloaded."; exit 0 ;;
        --settings)
            sc=""
            for e in "${SHORTCUTS[@]}"; do sc+="${sc:+, }$e"; done
            echo "default-status  = $DEFAULT_STATUS"
            echo "call-status     = $CALL_STATUS"
            echo "call-apps       = $CALL_APPS"
            echo "lock-status     = $LOCK_STATUS"
            echo "dnd-statuses    = ${DND_STATUSES[*]:-(none)}"
            echo "timer-shortcuts = ${sc:-(none)}"
            echo "brightness      = $BRIGHTNESS"
            echo "theme           = $THEME"
            exit 0 ;;
        --setting)
            case "${2:-}" in
                default-status) echo "$DEFAULT_STATUS" ;;
                call-status) echo "$CALL_STATUS" ;;
                call-apps) echo "$CALL_APPS" ;;
                lock-status) echo "$LOCK_STATUS" ;;
                dnd-statuses) echo "${DND_STATUSES[*]}" ;;
                brightness) echo "$BRIGHTNESS" ;;
                theme) echo "$THEME" ;;
                timer-shortcuts) [ "${#SHORTCUTS[@]}" -eq 0 ] || printf '%s\n' "${SHORTCUTS[@]}" ;;
                *) echo "Unknown setting '${2:-}'" >&2; exit 2 ;;
            esac
            exit 0 ;;
        --timer)
            show_timer; exit 0 ;;
        --cancel-timer)
            if [ -f "$TIMER" ]; then rm -f "$TIMER"; stop_timer_watchers; notify "$(t "Timer cancelled")"; fi
            exit 0 ;;
        --resume-timer)   # at login: restart the watcher, or end an expired timer
            if read -r end _ 2>/dev/null < "$TIMER"; then
                if [ "$end" -le "$(date +%s)" ]; then finish_timer "$(cat "$TIMER")"
                else start_timer_watcher "$(cat "$TIMER")"; fi
            fi
            exit 0 ;;
        --timer-expire)   # internal
            timer_expire "${2:-}"; exit 0 ;;
        --keep-timer)     # internal, used by luxafor-callwatch
            KEEP_TIMER=1; shift ;;
        --for)
            [ -n "${2:-}" ] || { echo "--for needs a duration, e.g. --for 30" >&2; exit 2; }
            DURATION="$2"; shift 2 ;;
        --for=*)
            DURATION="${1#--for=}"; shift ;;
        -*)
            echo "Unknown option: $1 (see --help)" >&2; exit 2 ;;
        *)
            [ -z "$NEXT" ] || { echo "Only one status at a time (got '$NEXT' and '$1')" >&2; exit 2; }
            NEXT="$1"; shift ;;
    esac
done

if [ -z "$NEXT" ]; then
    [ -z "$DURATION" ] || { echo "--for needs a status, e.g. luxafor-toggle busy --for 30" >&2; exit 2; }
    CUR="$(cat "$STATE" 2>/dev/null || echo off)"
    if [ "$CUR" = off ] || ! i="$(index_of "$CUR")"; then
        NEXT="${IDS[0]}"
    elif [ "$((i + 1))" -lt "${#IDS[@]}" ]; then
        NEXT="${IDS[$((i + 1))]}"
    else
        NEXT=off
    fi
elif [ "$NEXT" != off ] && ! index_of "$NEXT" >/dev/null; then
    echo "Unknown status '$NEXT'. Available: ${IDS[*]} off" >&2
    exit 2
fi

if [ -n "$DURATION" ]; then
    SECS="$(parse_duration "$DURATION")" \
        || { echo "Invalid duration '$DURATION' — use minutes (30), or 45m, 1h, 1h30 (max 24h)" >&2; exit 2; }
    END=$(( $(date +%s) + SECS ))
    set_status "$NEXT" "$(tf '%s for %s — until %s' "$(label_of "$NEXT")" "$(human_minutes "$SECS")" "$(date -d "@$END" +%H:%M)")"
    mkdir -p "$(dirname "$TIMER")"
    echo "$END $NEXT" > "$TIMER"
    start_timer_watcher "$END $NEXT"
else
    # A status chosen by hand replaces any running timer.
    if [ "$KEEP_TIMER" -eq 0 ] && [ -f "$TIMER" ]; then rm -f "$TIMER"; stop_timer_watchers; fi
    set_status "$NEXT"
fi
