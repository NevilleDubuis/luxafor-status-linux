[Desktop Entry]
Type=Application
Name=Luxafor
Comment=Changer le statut de la lampe Luxafor
Exec=@BINDIR@/luxafor-toggle
Icon=luxafor
Terminal=false
Categories=Utility;
Keywords=luxafor;busylight;statut;status;
Actions=green;red;yellow;off;

[Desktop Action green]
Name=Disponible (vert)
Exec=@BINDIR@/luxafor-toggle green

[Desktop Action red]
Name=Occupé (rouge)
Exec=@BINDIR@/luxafor-toggle red

[Desktop Action yellow]
Name=En appel (jaune)
Exec=@BINDIR@/luxafor-toggle yellow

[Desktop Action off]
Name=Éteindre
Exec=@BINDIR@/luxafor-toggle off
