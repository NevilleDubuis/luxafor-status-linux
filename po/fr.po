#: bin/luxafor-panel:109 bin/luxafor-tray:273
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} min"

#: bin/luxafor-panel:112 bin/luxafor-tray:276
#, python-brace-format
msgid "{hours} h"
msgstr "{hours} h"

#: bin/luxafor-panel:113 bin/luxafor-tray:277
#, python-brace-format
msgid "{hours} h {minutes:02d}"
msgstr "{hours} h {minutes:02d}"

#: bin/luxafor-panel:237 bin/luxafor-panel:354
msgid "Status"
msgstr "Statut"

#: bin/luxafor-panel:249
msgid "Settings"
msgstr "Réglages"

#: bin/luxafor-panel:269 bin/luxafor-tray:479
msgid "Cancel timer"
msgstr "Annuler le minuteur"

#: bin/luxafor-panel:277
msgid "1 · DURATION"
msgstr "1 · DURÉE"

#: bin/luxafor-panel:285
msgid "Custom duration"
msgstr "Durée personnalisée"

#: bin/luxafor-panel:293 bin/luxafor-panel:602
msgid "min"
msgstr "min"

#: bin/luxafor-panel:307
msgid "2 · STATUS"
msgstr "2 · STATUT"

#: bin/luxafor-panel:333
msgid "Pick a duration, then a status · Esc to close"
msgstr "Choisissez une durée, puis un statut · Échap pour fermer"

#: bin/luxafor-panel:384
#, python-brace-format
msgid "until {time} · {left} left, then {status}"
msgstr "jusqu’à {time} · encore {left}, puis {status}"

#: bin/luxafor-panel:390
msgid "No timer"
msgstr "Pas de minuteur"

#: bin/luxafor-panel:445
msgid "Don't change"
msgstr "Ne pas changer"

#: bin/luxafor-panel:446
msgid "Light off"
msgstr "Lampe éteinte"

#: bin/luxafor-panel:448
msgid "Follow the desktop"
msgstr "Comme le bureau"

#: bin/luxafor-panel:448
msgid "Light"
msgstr "Clair"

#: bin/luxafor-panel:448
msgid "Dark"
msgstr "Sombre"

#: bin/luxafor-panel:570
#, python-brace-format
msgid "Color of “{status}”"
msgstr "Couleur de « {status} »"

#: bin/luxafor-panel:577
msgid "Move up"
msgstr "Monter"

#: bin/luxafor-panel:578
msgid "Move down"
msgstr "Descendre"

#: bin/luxafor-panel:579 bin/luxafor-panel:603
msgid "Delete"
msgstr "Supprimer"

#: bin/luxafor-panel:600
msgid "for"
msgstr "pendant"

#: bin/luxafor-panel:617
msgid "STATUSES"
msgstr "STATUTS"

#: bin/luxafor-panel:620
msgid "Add status"
msgstr "Ajouter un statut"

#: bin/luxafor-panel:641
msgid "After a timer"
msgstr "Après un minuteur"

#: bin/luxafor-panel:641
msgid "Status to go back to when a timer ends"
msgstr "Statut repris à la fin d’un minuteur"

#: bin/luxafor-panel:642
msgid "During calls"
msgstr "Pendant les appels"

#: bin/luxafor-panel:642
msgid "Status used automatically while you are in a call"
msgstr "Statut utilisé automatiquement pendant un appel"

#: bin/luxafor-panel:643
msgid "Screen locked"
msgstr "Écran verrouillé"

#: bin/luxafor-panel:644
msgid ""
"Status while the screen is locked; the previous one comes back when you "
"unlock"
msgstr ""
"Statut pendant que l’écran est verrouillé ; le précédent revient au "
"déverrouillage"

#: bin/luxafor-panel:645
msgid "Brightness"
msgstr "Luminosité"

#: bin/luxafor-panel:645
msgid "Brightness of the light"
msgstr "Luminosité de la lampe"

#: bin/luxafor-panel:646
msgid "Theme"
msgstr "Thème"

#: bin/luxafor-panel:646
msgid "Look of this panel"
msgstr "Apparence de ce panneau"

#: bin/luxafor-panel:655
msgid "BEHAVIOR"
msgstr "COMPORTEMENT"

#: bin/luxafor-panel:660
msgid "DO NOT DISTURB"
msgstr "NE PAS DÉRANGER"

#: bin/luxafor-panel:661
msgid "Silence desktop notifications while:"
msgstr "Couper les notifications du bureau pendant :"

#: bin/luxafor-panel:662
msgid "Optional: you may still want to see incoming call notifications"
msgstr ""
"Facultatif : vous voudrez peut-être quand même voir les appels entrants"

#: bin/luxafor-panel:672
msgid "TIMERS IN THE TRAY MENU"
msgstr "MINUTEURS DU MENU"

#: bin/luxafor-panel:675
msgid "Add timer"
msgstr "Ajouter un minuteur"

#: bin/luxafor-panel:682
msgid "Edit the file…"
msgstr "Modifier le fichier…"

#: bin/luxafor-panel:691
msgid "Revert"
msgstr "Annuler"

#: bin/luxafor-panel:693
msgid "Save"
msgstr "Enregistrer"

#: bin/luxafor-panel:744
msgid "(no name)"
msgstr "(sans nom)"

#: bin/luxafor-panel:818
msgid "Keep at least one status."
msgstr "Gardez au moins un statut."

#: bin/luxafor-panel:857
msgid "Give every status a name."
msgstr "Donnez un nom à chaque statut."

#: bin/luxafor-panel:889
#, python-brace-format
msgid "Could not save: {error}"
msgstr "Enregistrement impossible : {error}"

#: bin/luxafor-panel:896
msgid "Saved."
msgstr "Enregistré."

#: bin/luxafor-tray:441 bin/luxafor-tray:495
msgid "Off"
msgstr "Éteint"

#: bin/luxafor-tray:447
#, python-brace-format
msgid "{status} until {time} ({left} left)"
msgstr "{status} jusqu’à {time} (encore {left})"

#: bin/luxafor-tray:472
msgid "Light not connected"
msgstr "Lampe non connectée"

#: bin/luxafor-tray:489
#, python-brace-format
msgid "{status} for {duration}"
msgstr "{status} pendant {duration}"

#: bin/luxafor-tray:491
msgid "More…"
msgstr "Plus…"

#: bin/luxafor-tray:498
msgid "Quit"
msgstr "Quitter"

#: bin/luxafor-tray:529
#, python-brace-format
msgid "{status} — light not connected"
msgstr "{status} — lampe non connectée"

#: bin/luxafor-tray:607
#, python-brace-format
msgid ""
"Light disconnected — {status} will be shown again when it's plugged back in"
msgstr ""
"Lampe déconnectée — {status} sera réaffiché quand elle sera rebranchée"

#: bin/luxafor-tray:618
#, python-brace-format
msgid "Light reconnected — {status}"
msgstr "Lampe reconnectée — {status}"

#: bin/luxafor-toggle:89
msgid "Available"
msgstr "Disponible"

#: bin/luxafor-toggle:89
msgid "Busy"
msgstr "Occupé"

#: bin/luxafor-toggle:89
msgid "On a call"
msgstr "En appel"

#: bin/luxafor-toggle:261
msgid "Change the Luxafor light status"
msgstr "Changer le statut de la lampe Luxafor"

#: bin/luxafor-toggle:268
msgid "Open panel…"
msgstr "Ouvrir le panneau…"

#: bin/luxafor-toggle:322
msgid "%d min"
msgstr "%d min"

#: bin/luxafor-toggle:324
msgid "%d h"
msgstr "%d h"

#: bin/luxafor-toggle:326
msgid "%d h %02d"
msgstr "%d h %02d"

#: bin/luxafor-toggle:368
msgid "Timer ended — %s"
msgstr "Minuteur terminé — %s"

#: bin/luxafor-toggle:375
msgid "No timer."
msgstr "Pas de minuteur."

#: bin/luxafor-toggle:380
msgid "%s until %s (%s left), then %s\\n"
msgstr "%s jusqu’à %s (encore %s), puis %s\\n"

#: bin/luxafor-toggle:408
msgid "%s — light not connected"
msgstr "%s — lampe non connectée"

#: bin/luxafor-toggle:479
msgid "Timer cancelled"
msgstr "Minuteur annulé"

#: bin/luxafor-toggle:523
msgid "%s for %s — until %s"
msgstr "%s pendant %s — jusqu’à %s"

#: bin/luxafor-light:112
msgid "no Luxafor light found — is it plugged in?"
msgstr "aucune lampe Luxafor trouvée — est-elle branchée ?"

#: bin/luxafor-light:120
msgid "cannot write to %s (permission denied? replug the light)"
msgstr "impossible d’écrire sur %s (permission refusée ? rebranchez la lampe)"

#: bin/luxafor-light:144
msgid "unknown color '%s' — use a name (red, orange…) or a hex code (#ff8800)"
msgstr ""
"couleur inconnue « %s » — utilisez un nom (red, orange…) ou un code "
"hexadécimal (#ff8800)"

#: bin/luxafor-callwatch:142
msgid "pactl not found — install it with: sudo apt install pulseaudio-utils"
msgstr ""
"pactl introuvable — installez-le avec : sudo apt install pulseaudio-utils"

#: bin/luxafor-callwatch:144
msgid ""
"callwatch.conf is no longer read: set the call status and the watched apps "
"in Luxafor Panel → Settings (call-status, call-apps in statuses.conf)"
msgstr ""
"callwatch.conf n’est plus lu : réglez le statut d’appel et les applications "
"surveillées dans Luxafor Panel → Réglages (call-status, call-apps dans "
"statuses.conf)"
