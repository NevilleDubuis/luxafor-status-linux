msgid "Follow the desktop"
msgstr "Comme le bureau"

#: bin/luxafor-panel:473
msgid "Light"
msgstr "Clair"

#: bin/luxafor-panel:473
msgid "Dark"
msgstr "Sombre"

#: bin/luxafor-panel:600
#, python-brace-format
msgid "Color of “{status}”"
msgstr "Couleur de « {status} »"

#: bin/luxafor-panel:609
msgid "How the light shows this status"
msgstr "Comment la lumière affiche ce statut"

#: bin/luxafor-panel:614
msgid "Move up"
msgstr "Monter"

#: bin/luxafor-panel:615
msgid "Move down"
msgstr "Descendre"

