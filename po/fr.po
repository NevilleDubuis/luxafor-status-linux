msgid "Edit the file…"
msgstr "Modifier le fichier…"

#: bin/luxafor-panel:729
msgid "Revert"
msgstr "Annuler"

#: bin/luxafor-panel:731
msgid "Save"
msgstr "Enregistrer"

#: bin/luxafor-panel:782
msgid "(no name)"
msgstr "(sans nom)"

#: bin/luxafor-panel:856
msgid "Keep at least one status."
msgstr "Gardez au moins un statut."

#: bin/luxafor-panel:895
msgid "Give every status a name."
msgstr "Donnez un nom à chaque statut."

#: bin/luxafor-panel:927
#, python-brace-format
msgid "Could not save: {error}"
msgstr "Enregistrement impossible : {error}"

#: bin/luxafor-panel:934
msgid "Saved."
msgstr "Enregistré."

#: bin/luxafor-tray:450 bin/luxafor-tray:504
msgid "Off"
msgstr "Éteint"

#: bin/luxafor-tray:456
#, python-brace-format
msgid "{status} until {time} ({left} left)"
msgstr "{status} jusqu’à {time} (encore {left})"

#: bin/luxafor-tray:481
msgid "Light not connected"
msgstr "Lampe non connectée"

#: bin/luxafor-tray:498
#, python-brace-format
msgid "{status} for {duration}"
msgstr "{status} pendant {duration}"

#: bin/luxafor-tray:500
msgid "More…"
msgstr "Plus…"

#: bin/luxafor-tray:507
msgid "Quit"
msgstr "Quitter"

#: bin/luxafor-tray:538
#, python-brace-format
msgid "{status} — light not connected"
msgstr "{status} — lampe non connectée"

#: bin/luxafor-tray:616
#, python-brace-format
msgid ""
"Light disconnected — {status} will be shown again when it's plugged back in"
msgstr "Lampe déconnectée — {status} sera réaffiché quand elle sera rebranchée"

#: bin/luxafor-tray:627
#, python-brace-format
msgid "Light reconnected — {status}"
msgstr "Lampe reconnectée — {status}"

#: bin/luxafor-toggle:94
msgid "Available"
msgstr "Disponible"

#: bin/luxafor-toggle:94
msgid "Busy"
msgstr "Occupé"

#: bin/luxafor-toggle:94
msgid "On a call"
msgstr "En appel"

#: bin/luxafor-toggle:272
msgid "Change the Luxafor light status"
msgstr "Changer le statut de la lampe Luxafor"

#: bin/luxafor-toggle:279
msgid "Open panel…"
msgstr "Ouvrir le panneau…"

#: bin/luxafor-toggle:333
msgid "%d min"
msgstr "%d min"

#: bin/luxafor-toggle:335
msgid "%d h"
msgstr "%d h"

#: bin/luxafor-toggle:337
msgid "%d h %02d"
msgstr "%d h %02d"

#: bin/luxafor-toggle:379
msgid "Timer ended — %s"
msgstr "Minuteur terminé — %s"

#: bin/luxafor-toggle:386
msgid "No timer."
msgstr "Pas de minuteur."

#: bin/luxafor-toggle:391
msgid "%s until %s (%s left), then %s\\n"
msgstr "%s jusqu’à %s (encore %s), puis %s\\n"

#: bin/luxafor-toggle:423
msgid "%s — light not connected"
msgstr "%s — lampe non connectée"

#: bin/luxafor-toggle:497
msgid "Timer cancelled"
msgstr "Minuteur annulé"

#: bin/luxafor-toggle:541
msgid "%s for %s — until %s"
msgstr "%s pendant %s — jusqu’à %s"

#: bin/luxafor-light:119
msgid "no Luxafor light found — is it plugged in?"
msgstr "aucune lampe Luxafor trouvée — est-elle branchée ?"

#: bin/luxafor-light:127
msgid "cannot write to %s (permission denied? replug the light)"
msgstr "impossible d’écrire sur %s (permission refusée ? rebranchez la lampe)"

#: bin/luxafor-light:151
msgid "unknown color '%s' — use a name (red, orange…) or a hex code (#ff8800)"
msgstr ""
"couleur inconnue « %s » — utilisez un nom (red, orange…) ou un code "
"hexadécimal (#ff8800)"

#: bin/luxafor-light:160
msgid "unknown effect '%s' — use: blink, blink slow, blink fast"
msgstr "effet inconnu « %s » — utilisez : blink, blink slow, blink fast"

#: bin/luxafor-callwatch:142
msgid "pactl not found — install it with: sudo apt install pulseaudio-utils"
msgstr ""
"pactl introuvable — installez-le avec : sudo apt install pulseaudio-utils"

#: bin/luxafor-callwatch:144
msgid ""
"callwatch.conf is no longer read: set the call status and the watched apps "
"in Luxafor Panel → Settings (call-status, call-apps in statuses.conf)"
msgstr ""
"callwatch.conf n’est plus lu : réglez le statut d’appel et les applications "
"surveillées dans Luxafor Panel → Réglages (call-status, call-apps dans "
"statuses.conf)"
