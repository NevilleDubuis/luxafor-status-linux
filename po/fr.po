msgid "Status used automatically while you are in a call"
msgstr "Statut utilisé automatiquement pendant un appel"

#: bin/luxafor-panel:681
msgid "Screen locked"
msgstr "Écran verrouillé"

#: bin/luxafor-panel:682
msgid ""
"Status while the screen is locked; the previous one comes back when you "
"unlock"
msgstr ""
"Statut pendant que l’écran est verrouillé ; le précédent revient au "
"déverrouillage"

#: bin/luxafor-panel:683
msgid "Brightness"
msgstr "Luminosité"

#: bin/luxafor-panel:683
msgid "Brightness of the light"
msgstr "Luminosité de la lampe"

#: bin/luxafor-panel:684
msgid "Theme"
msgstr "Thème"

#: bin/luxafor-panel:684
msgid "Look of this panel"
msgstr "Apparence de ce panneau"

