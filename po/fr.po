msgid "for"
msgstr "pendant"

#: bin/luxafor-panel:655
msgid "STATUSES"
msgstr "STATUTS"

#: bin/luxafor-panel:658
msgid "Add status"
msgstr "Ajouter un statut"

#: bin/luxafor-panel:679
msgid "After a timer"
msgstr "Après un minuteur"

