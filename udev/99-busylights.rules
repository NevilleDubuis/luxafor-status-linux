# Règle de secours si « busylight udev-rules » n'est pas disponible.
# Donne à l'utilisateur connecté l'accès aux lampes Luxafor qui utilisent l'ID USB 04d8:f372.
# Vérifie l'ID de ta lampe avec : lsusb | grep -i 04d8
SUBSYSTEMS=="usb", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="f372", TAG+="uaccess", MODE="0660"
KERNEL=="hidraw*", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="f372", TAG+="uaccess", MODE="0660"
