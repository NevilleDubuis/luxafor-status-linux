# Fallback rule, used only if "busylight udev-rules" is not available.
# Gives the logged-in user access to Luxafor lights with USB ID 04d8:f372.
# Check your light's ID with: lsusb | grep -i 04d8
SUBSYSTEMS=="usb", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="f372", TAG+="uaccess", MODE="0660"
KERNEL=="hidraw*", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="f372", TAG+="uaccess", MODE="0660"
